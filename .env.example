# Получить api_id и api_hash можно на https://my.telegram.org
API_ID=12345678
API_HASH=your_api_hash_here

# Интервал отправки сообщений в минутах (используется только в main.py)
INTERVAL_MINUTES=5

# Список получателей (usernames или chat_id через запятую)
# Пример: @user1, @chat2, -100123456789
TARGETS=-100123456789

# Текст рассылки (только для main.py)
MESSAGE_TEXT=.отн сделать комплимент

# ─────────────────────────────────────────────────────────────────────────────
# Настройки для farmer.py (умный фармер отношений)
# ─────────────────────────────────────────────────────────────────────────────
# Укажите сколько искр у вас УЖЕ ЕСТЬ в боте (например 25000),
# чтобы фармер сразу начал с действий соответствующего высокого уровня:
CURRENT_SPARKS=0

# Или укажите текущий уровень (1-18), если не помните точное число искр:
# CURRENT_LEVEL=5
CURRENT_LEVEL=0
